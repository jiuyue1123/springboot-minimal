# Copy this file to .env and adjust the values for your machine.
# Spring Boot does not read .env by itself; provide these variables through your IDE run
# configuration, a docker compose `env_file`, or `export` in the shell.
#
# Dev and test profiles fall back to local defaults; the prod profile requires
# DB_HOST, DB_NAME, DB_USERNAME and DB_PASSWORD to be set.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=springboot_minimal
DB_USERNAME=root
DB_PASSWORD=root

# Redis connection, see spring.data.redis in application.yml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
